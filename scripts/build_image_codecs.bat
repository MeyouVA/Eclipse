@echo off
setlocal
cd /d "%~dp0.."
call scripts\findtools.bat || exit /b 1
set "CODEC_ROOT=%CD%\thirdparty"
set "CODEC_BUILD=%CODEC_ROOT%\build"
set "CODEC_INSTALL=%CODEC_ROOT%\heif"
cmake -S thirdparty\x265\source -B "%CODEC_BUILD%\x265-10" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DENABLE_ASSEMBLY=OFF -DENABLE_CLI=OFF -DENABLE_SHARED=OFF -DEXPORT_C_API=OFF -DHIGH_BIT_DEPTH=ON -DENABLE_LIBNUMA=OFF || exit /b 1
cmake --build "%CODEC_BUILD%\x265-10" || exit /b 1
cmake -S thirdparty\x265\source -B "%CODEC_BUILD%\x265-12" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DENABLE_ASSEMBLY=OFF -DENABLE_CLI=OFF -DENABLE_SHARED=OFF -DEXPORT_C_API=OFF -DHIGH_BIT_DEPTH=ON -DMAIN12=ON -DENABLE_LIBNUMA=OFF || exit /b 1
cmake --build "%CODEC_BUILD%\x265-12" || exit /b 1
cmake -S thirdparty\x265\source -B "%CODEC_BUILD%\x265-8" -G Ninja -DCMAKE_BUILD_TYPE=Release -DCMAKE_POLICY_VERSION_MINIMUM=3.5 -DENABLE_ASSEMBLY=OFF -DENABLE_CLI=OFF -DENABLE_SHARED=ON -DENABLE_LIBNUMA=OFF -DLINKED_10BIT=ON -DLINKED_12BIT=ON "-DEXTRA_LIB=%CODEC_BUILD%\x265-10\x265-static.lib;%CODEC_BUILD%\x265-12\x265-static.lib" "-DCMAKE_INSTALL_PREFIX=%CODEC_INSTALL%" || exit /b 1
cmake --build "%CODEC_BUILD%\x265-8" || exit /b 1
cmake --install "%CODEC_BUILD%\x265-8" || exit /b 1
cmake -S thirdparty\libheif -B "%CODEC_BUILD%\libheif" -G Ninja -DCMAKE_BUILD_TYPE=Release "-DCMAKE_INSTALL_PREFIX=%CODEC_INSTALL%" "-DCMAKE_PREFIX_PATH=%CODEC_INSTALL%" -DWITH_X265=ON -DWITH_X265_PLUGIN=OFF -DENABLE_PLUGIN_LOADING=OFF -DWITH_LIBDE265=OFF -DWITH_X264=OFF -DWITH_OpenH264_DECODER=OFF -DWITH_AOM_DECODER=OFF -DWITH_AOM_ENCODER=OFF -DWITH_DAV1D=OFF -DWITH_RAV1E=OFF -DWITH_SvtEnc=OFF -DWITH_EXAMPLES=OFF -DWITH_GDK_PIXBUF=OFF -DBUILD_TESTING=OFF -DBUILD_DOCUMENTATION=OFF -DWITH_LIBSHARPYUV=OFF -DWITH_HEADER_COMPRESSION=OFF || exit /b 1
cmake --build "%CODEC_BUILD%\libheif" || exit /b 1
cmake --install "%CODEC_BUILD%\libheif" || exit /b 1
copy /y thirdparty\x265\COPYING "%CODEC_INSTALL%\X265-COPYING.txt" >nul || exit /b 1
copy /y thirdparty\libheif\COPYING "%CODEC_INSTALL%\LIBHEIF-COPYING.txt" >nul || exit /b 1
cmake -S . -B out -G Ninja -DCMAKE_BUILD_TYPE=Release "-DCMAKE_PREFIX_PATH=%CMAKE_PREFIX_PATH%" || exit /b 1
cmake --build out --target EclipseHeifTool || exit /b 1
echo HEIC encoding libraries ready: %CODEC_INSTALL%
