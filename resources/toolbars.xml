 <toolbar id="DrawingToolToolbar" text="Tools" orientation="vertical">
  <multibutton id="selectTools1">
   <item id="ToolSelect"/>
   <item id="ToolCutter"/>
   <item id="ToolPerspective"/>
   <item id="ToolEnvelope"/>
   <item id="ToolReposition"/>
  </multibutton>
  <multibutton id="selectTools2">
   <item id="ToolContourEditor"/>
   <item id="ToolPencilEditor"/>
   <item id="ToolPencilRetouch"/>
   <item id="ToolSmoothEditor"/>
   <item id="ToolMorphing"/>
  </multibutton>
  <multibutton id="brushTools">
   <item id="ToolBrush"/>
   <item id="ToolStamp"/>
  </multibutton>
  <item id="ToolPencil"/>
  <item id="ToolEraser"/>
  <item id="ToolText"/>
  <multibutton id="shapeTools">
   <item id="ToolRectangle"/>
   <item id="ToolEllipse"/>
   <item id="ToolLine"/>
   <item id="ToolPolyline"/>
  </multibutton>
  <multibutton id="paintTools">
   <item id="ToolPaint"/>
   <item id="ToolPaintUnpainted"/>
   <item id="ToolRepaint"/>
   <item id="ToolUnpaint"/>
   <item id="ToolInk"/>
   <item id="ToolRepaintBrush"/>
   <item id="ToolStroke"/>
   <item id="ToolCloseGap"/>
   <item id="ToolEditGradient"/>
  </multibutton>
  <item id="ToolDropper"/>
