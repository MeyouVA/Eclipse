   <item id="ToolHand"/>
   <item id="ToolZoom"/>
   <item id="ToolRotateView"/>
  </multibutton>
  <separator/>
  <item id="ToolTransform"/>
  <item id="ToolRigging"/>
  <item id="ToolIK"/>
  <item id="ToolSplineOffset"/>
  <item id="ToolTurn3D"/>
  <item id="ToolDrawingPivot"/>
