# Eclipse light theme: the values Master.qss refers to as $[name].
# Light greys, with the same teal highlight.
window          = #dcdcdc
panel           = #e4e4e4
base            = #f7f7f7
raised          = #cfcfcf
border          = #a8a8a8
text            = #1e1e1e
textDim         = #6a6a6a
accent          = #1f8496
accentSoft      = #9ccfd8
hover           = #c4c4c4
