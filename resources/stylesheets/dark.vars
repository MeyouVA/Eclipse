window          = #454545
panel           = #4a4a4a
base            = #2e2e2e
raised          = #585858
border          = #2a2a2a
text            = #d2d2d2
textDim         = #8a8a8a
accent          = #2a9bb0
accentSoft      = #2f6f7c
hover           = #5e5e5e
